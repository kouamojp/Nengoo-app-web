Options -MultiViews
RewriteEngine On

# Forcer HTTPS et le domaine avec www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.nengoo.com/$1 [L,R=301]

# Sitemap généré par le backend
RewriteRule ^sitemap\.xml$ og-proxy.php?type=sitemap [L,QSA]

# Fiches produit, boutiques et catégories : index.html avec le contenu, le
# titre, les aperçus (Open Graph) et les données structurées déjà dedans,
# pour tout le monde (page.php). Anciennes adresses : redirection 301.
# Les sections de l'espace vendeur (/seller/orders…) restent l'application seule.
RewriteCond %{REQUEST_URI} !^/seller/(products|media|orders|analytics|profile|messages|support|promos)/?$ [NC]
RewriteRule ^(product|seller|catalog)/[^/]+/?$ page.php [L]

# Accueil : index.html avec les réglages du carrousel intégrés (home.php),
# pour que la première image se charge dès la lecture du HTML
RewriteRule ^$ home.php [L]

# Application React (SPA) : tout ce qui n'est pas un fichier réel → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Cache : fichiers versionnés longtemps, index.html et service worker revalidés
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # « no-cache » : toujours revalidé auprès du serveur, mais sans « no-store »
  # qui empêche le retour instantané (cache avant/arrière du navigateur)
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
